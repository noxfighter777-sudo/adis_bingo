{
  "name": "rest-express",
  "version": "1.0.0",
  "description": "Grand Bingo Desktop Application - Professional Bingo Management System",
  "author": "Fira Tech Solutions",
  "license": "MIT",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file=.env server/index.ts",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "start:web": "NODE_ENV=production tsx --env-file=.env server/index.ts",
    "check": "tsc",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "vercel-build": "prisma generate && vite build",
    "postinstall": "prisma generate",
    "electron": "NODE_ENV=development electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.8",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.1",
    "@tanstack/react-query": "^5.60.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/memoizee": "^0.4.12",
    "@types/sqlite3": "^3.1.11",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-sqlite3": "^0.9.16",
    "crypto": "^1.0.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "framer-motion": "^11.13.1",
    "input-otp": "^1.4.2",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.453.0",
    "memoizee": "^0.4.17",
    "nanoid": "^5.1.5",
    "node-forge": "^1.3.3",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "^0.2.7",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-sqlite3": "^0.9.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/fs-extra": "^11.0.4",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^22.10.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.35",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.59.0",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0"
  },
  "build": {
    "appId": "com.firatech.bingomaster",
    "productName": "GrandBingo",
    "publish": [
      {
        "provider": "github",
        "owner": "noxfighter777-sudo",
        "repo": "adis_bingo"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "client/public/go_bingo.png",
      "compression": "maximum"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GrandBingo"
    },
    "files": [
      "main.cjs",
      "preload.js",
      "node_modules/@prisma/**/*",
      "node_modules/prisma/**/*",
      "dist/**/*",
      "prisma/schema.prisma",
      "prisma/migrations/**/*",
      "public/**/*",
      "!**/node_modules/**/*",
      "!**/*.ts",
      "!**/*.map",
      "!**/src/**/*",
      "!**/test/**/*",
      "!**/tests/**/*",
      "!**/*.md",
      "!**/.git/**/*",
      "!**/.github/**/*",
      "!**/attached_assets/**/*",
      "!**/data/**/*",
      "!**/logs/**/*",
      "!**/api/**/*",
      "!**/client/src/**/*",
      "!**/server/src/**/*",
      "!**/scripts/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{mp3,wav,png,jpg,jpeg}",
      "public/**/*",
      "prisma/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/prisma/**/*"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": ["**/*"]
      },
      {
        "from": "public",
        "to": "public",
        "filter": ["**/*.{mp3,wav,png,jpg,jpeg}"]
      },
      {
        "from": "main.cjs",
        "to": "main.cjs"
      },
      {
        "from": "preload.js",
        "to": "preload.js"
      }
    ],
    "npmRebuild": false
  }
}
